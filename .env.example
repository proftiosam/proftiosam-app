# Copie para .env.local e preencha. Nunca comite o arquivo preenchido.
# Na Vercel, estas mesmas chaves vão em Settings > Environment Variables.

# Banco (Neon) ----------------------------------------------------------
# Painel do Neon > Connection string > "Pooled connection".
# A pooled é obrigatória: a direta esgota conexão em ambiente serverless.
DATABASE_URL=

# Sessão ----------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Entrada ---------------------------------------------------------------
# O aluno digita este código + escolhe um apelido. Sem senha.
JOIN_CODE=ING-TESTE
# Só você usa este. Nunca mande junto com o código dos alunos.
TEACHER_CODE=

# Notificações (Web Push) ----------------------------------------------
# Gere o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@proftiosam.com

# Cron ------------------------------------------------------------------
# A Vercel manda este valor no header Authorization das rotas agendadas.
# Sem ele, qualquer um na internet dispara seus lembretes.
CRON_SECRET=

TZ=America/Sao_Paulo
